# Host port used by Docker Compose
APP_PORT=8080

# Direct Node.js hosting settings
HOST=0.0.0.0
PORT=8080

# Enterprise PostgreSQL settings used by Docker Compose
POSTGRES_PASSWORD=replace-with-a-long-random-password
DB_POOL_MAX=20
# Keep false for localhost HTTP. Set true only behind production HTTPS.
COOKIE_SECURE=false
SEED_ADMIN_PASSWORD=replace-admin-password
SEED_SUPPORT_PASSWORD=replace-support-password
SEED_USER_PASSWORD=replace-user-password

# Direct Windows/Linux hosting (when PostgreSQL runs separately)
# DATABASE_URL=postgresql://dhruv_setu:password@localhost:5432/dhruv_setu
